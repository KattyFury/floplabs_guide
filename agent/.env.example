# Điền rồi lưu file. File này KHÔNG được đưa lên GitHub.

# Token bot Telegram: nhắn @BotFather → /newbot → làm theo → copy token
TELEGRAM_BOT_TOKEN=

# Tên DID bạn đã tạo bằng: node scripts/generate-did.js <ten>
DID_LABEL=

# (Tuỳ chọn) Não FLOP: đường dẫn file key gateway do Flop CLI tạo. Bỏ trống = mặc định ~/.flop/devnet-wallet-agent-key.json
# (cài đặt bằng install.ps1 / install.sh đã tạo sẵn). Trong image CLI chính thức (VPS) không cần điền.
FLOP_KEY_FILE=
